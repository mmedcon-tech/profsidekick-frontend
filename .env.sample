NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_IS_LOCAL=true

# Server-side only — never commit real keys
# Optional here if the backend API (profsidekick-api/.env) already has OPENAI_API_KEY;
# the chatbot will proxy to http://localhost:8000/api/assistant/chat when this is empty.
OPENAI_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
NEXT_PUBLIC_HEYGEN_ENABLED=false